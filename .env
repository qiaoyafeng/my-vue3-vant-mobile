VITE_APP_PUBLIC_PATH=/
VITE_APP_PREVIEW=true
VITE_APP_API_BASE_URL=/api
VITE_APP_OUT_DIR=dist
VITE_APP_VCONSOLE=false
VITE_FACE_FRAME_COUNT=100

# LLM 网关地址（OpenAI 兼容）。开发期指向本地 mock；接真实网关时改为网关地址
VITE_OPENAI_BASE_URL=/api/openai/v1
# 模型名
VITE_OPENAI_MODEL=gpt-4o-mini
# 系统提示词（可选，留空则不发送 system 消息）
VITE_OPENAI_SYSTEM_PROMPT=
